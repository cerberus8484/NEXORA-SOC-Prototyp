# ─────────────────────────────────────────────────────────────────────────────
# Nexora SOC Lab — Secrets (NIEMALS committen!)
#
# Kopieren nach secrets.env, Werte eintragen, dann:
#   set -a; source secrets.env; set +a
#   ./deploy-lab.sh all
#
# secrets.env ist in .gitignore. Alle Passwoerter muessen die Windows-
# Komplexitaet erfuellen: min. 8 Zeichen, Gross+Klein+Zahl+Sonderzeichen.
# ─────────────────────────────────────────────────────────────────────────────

# Windows lokales Administrator-Passwort (vor Domain-Join, beide Win-VMs)
export WIN_LOCAL_ADMIN_PW=""

# Domain Admin (NEXORA\Administrator) — nach AD-Promotion
export AD_ADMIN_PW=""

# DSRM (Directory Services Restore Mode) Passwort fuer DC01
export AD_DSRM_PW=""

# Linux cloud-init User-Passwort (Fallback neben SSH-Key)
export LINUX_USER_PW=""
