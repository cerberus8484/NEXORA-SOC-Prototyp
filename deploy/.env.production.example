# SOC Ticket Tool — Produktions-Konfiguration
# Kopiere nach .env.production und setze alle Werte.
# WICHTIG: Diese Datei NIEMALS committen!

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── CORS: NUR interne Origin(s) ──────────────────────────────
# Kein * und kein localhost!
CORS_ORIGINS=https://soc.example.com

# Frontend-Wiki-Basis fuer Tooltip-"more"-Links.
# Leer lassen = im Frontend erscheint kein Wiki-Link.
VITE_WIKI_BASE_URL=/docs

# ── PostgreSQL ─────────────────────────────────────────────────
# DB_ENABLED=true ist im docker-compose.prod.yml bereits fest gesetzt.
# Ohne diese Variable läuft die App auf InMemory (nichts überlebt einen Restart).
# Mit DB_ENABLED=true sind Tickets, User, Audit und Threat Hunts persistent (P14).
DB_ENABLED=true
DB_HOST=postgres
DB_PORT=5432
DB_NAME=soc_tickets_prod
DB_USER=soc_api
# PFLICHT: Starkes Passwort, min. 20 Zeichen
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DB_SSL=false
DB_POOL_MAX=10

# ── Auth — JWT ─────────────────────────────────────────────────
# PFLICHT: Zufällig generiert, min. 64 Zeichen
# Generator: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=8h

# ── Audit-Log IP-Pseudonymisierung (DSGVO Art. 25) ─────────────
# PFLICHT in Produktion (Fail-fast in validateEnv): ohne diesen Salt wären die
# gehashten Audit-IPs über den bekannten Dev-Default de-anonymisierbar.
# Generator: openssl rand -hex 32   (min. 32 Zeichen)
AUDIT_IP_SALT=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Security-Welle 3: MFA (TOTP) + Personal Access Tokens ──────
# Beide default AUS (inert nach Deploy). Aktivierung opt-in:
#   MFA_ENABLED=true        → /v1/mfa + Login-Challenge (MFA bleibt pro User opt-in;
#                             Bestandsnutzer werden NICHT ausgesperrt).
#   API_TOKENS_ENABLED=true → /v1/tokens (Personal Access Tokens; Tabelle api_tokens
#                             existiert seit Migration 030).
MFA_ENABLED=false
API_TOKENS_ENABLED=false

# ── Outbound-Ticket-Export (P12, ServiceNow/OTRS) ──────────────
# Default AUS. true nur, wenn ein Zielsystem konfiguriert ist (SERVICENOW_BASE_URL/
# _USERNAME/_PASSWORD bzw. OTRS_BASE_URL/_USERNAME/_PASSWORD). Diese Adapter-Creds
# müssen dann ebenfalls im environment-Block des Prod-Compose durchgereicht werden.
EXTERNAL_TICKET_EXPORT_ENABLED=false

# ── Outbound-Benachrichtigungen (Slack / Webhook / MS Teams) ───
# Default AUS. true + mind. eine URL nötig. URLs bleiben backend-only.
# Teams: "Incoming Webhook"-Connector im Kanal anlegen → URL hier eintragen.
NOTIFICATIONS_OUTBOUND_ENABLED=false
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=
NOTIFY_TEAMS_WEBHOOK_URL=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_SECURE=false
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# E-Mail/IMAP-Phishing-Ingest — leer = Poller bleibt inert.
# Interner docker-mailserver im Lab:
#   IMAP_HOST=10.99.99.85
#   IMAP_PORT=143
#   IMAP_TLS=false
#   IMAP_USER=phishing@nexora.local
#   IMAP_PASSWORD=<konto-passwort>
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASSWORD=

# ── Initialer Admin (Bootstrap) ────────────────────────────────
# Wird beim Start NUR angelegt, wenn dieser Account noch nicht existiert
# (idempotent). Passwort min. 8 Zeichen. Nach dem ersten Login kann der
# Wert entfernt werden — der Admin bleibt in der DB.
ADMIN_EMAIL=admin@firma.de
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── TLS — Zertifikatspfade auf dem Host ──────────────────────
# Pfade auf der VM (werden in docker-compose gemountet)
TLS_CERT_PATH=/etc/ssl/soc/server.crt
TLS_KEY_PATH=/etc/ssl/soc/server.key

# ── Webhook Secrets ────────────────────────────────────────────
# PFLICHT wenn Integrationen aktiv: min. 32 Zeichen, zufällig
# Generator: openssl rand -hex 32
WEBHOOK_SECRET_GENERIC=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Wazuh: PFLICHT wenn Wazuh-Integration aktiv (muss mit Script auf Wazuh-VM übereinstimmen)
# Generator: openssl rand -hex 32
WEBHOOK_SECRET_WAZUH=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Eigenes Secret für die Data-Plane-Status-Brücke (POST /dataplane/status). Generator: openssl rand -hex 32
WEBHOOK_SECRET_DATAPLANE=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Wazuh → Ticket: Rausch-Filter & Korrelation ───────────────
# Tickets erst ab diesem Rule-Level (filtert z.B. "A process was created" = Level 3).
# 5 = Default: fängt Auth-Fehler/Brute-Force (sshd Rule 5710 = Level 5), droppt Level-3-Rauschen.
# 3 = sehr gesprächig · 7/10 = nur deutliche Treffer/Angriffe.
WAZUH_MIN_LEVEL=5
# Wiederkehrende Offense (Rule+Agent) aktualisiert das offene Ticket nur innerhalb
# dieses Fensters (Stunden); danach entsteht ein neuer Case. 0 = nie zusammenfassen.
WAZUH_CORRELATION_WINDOW_H=24

# ── Wazuh-API (Pull/Enrichment) — optional ────────────────────
# Wenn gesetzt, zieht das Backend beim Ticket-Erstellen Agent-Details (OS, Host,
# Status) aus der Wazuh-API und reichert das Ticket an. Leer = Enrichment aus.
# User/Passwort aus wazuh-passwords.txt (API-User 'wazuh'). Self-signed Cert wird akzeptiert.
WAZUH_API_URL=https://10.99.99.77:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=CHANGE_ME_WAZUH_API_PASSWORD

# ── SAFETY GATE: produktiver False-Positive-Schreibpfad (Stage 4) ──
# Default false → Stage 4 ist nach Deploy bewusst UNSCHARF (apply/restart/revert → 403).
# NUR auf 'true' setzen, wenn ihr den echten Wazuh-Rule-Write+Restart bewusst freigebt
# ("Stage 4 scharfschalten"). Vorschau/XML-Export funktionieren unabhängig davon.
WAZUH_FP_APPLY_ENABLED=false

# ── SAFETY GATE: Deployment Center (ADR-041) — infra-schreibender VM-Deploy ──────
# Default AUS → Klon/Start/Rollback/Config nur als Read/Plan; jeder echte Apply → 403.
# NUR scharfschalten NACH Live-Smoke auf Lab-Proxmox. Bei DEPLOY_ENABLED=true sind
# DEPLOY_HYPERVISOR_ALLOWED_HOSTS und ein dediziertes SETTINGS_ENC_KEY PFLICHT —
# sonst bricht der API-Boot bewusst ab (validateEnv).
DEPLOY_ENABLED=false
# SSRF-Allowlist: erlaubte Hypervisor-Hosts (kommagetrennt). Pflicht bei enabled.
DEPLOY_HYPERVISOR_ALLOWED_HOSTS=
# Dedizierter Schlüssel für Deploy-/Connector-Secrets (AES-256-GCM), ≥32 zufällige
# Zeichen, getrennt von JWT_SECRET. Generator: openssl rand -hex 32
SETTINGS_ENC_KEY=
# config-Zustellkanal in den Gast. 'none' (Default) = fail-safe: der config-Schritt
# wirft → Deploy rollt kontrolliert zurück (keine unkonfigurierte VM als „deployed").
# 'first-boot-drive' = gerenderte config.xml als CD-ROM anhängen; der First-Boot-
# Importer im OPNsense-Golden-Template zieht /conf/config.xml beim Boot.
DEPLOY_DELIVER_CHANNEL=none
# Reauth-Frische-Fenster (Sekunden) und Status-Poll-Timeout nach dem VM-Start (ms).
DEPLOY_REAUTH_WINDOW_S=300
DEPLOY_STATUS_POLL_TIMEOUT_MS=120000

# ── SAFETY GATE: System-Operationen aus der Admin-UI (Restart / Self-Update) ──
# Default AUS → die Buttons auf /system bleiben sichtbar, aber fail-closed gesperrt.
# Diese Befehle laufen NICHT im API-Container "magisch", sondern stoßen nur einen
# hostseitig hinterlegten Befehl an. Darum nur freigeben, wenn:
#   1. das Repo auf dem Zielhost wirklich unter SYSTEM_CONTROL_REPO_ROOT liegt,
#   2. die Kommandos dort manuell verifiziert wurden,
#   3. bewusst akzeptiert ist, dass der Call nur "accepted" zurückgibt und die API
#      während Update/Restart kurz verschwinden kann.
#
# Beispielwerte auf einem Host mit echtem Checkout:
# SYSTEM_CONTROL_REPO_ROOT=/opt/nexora
# SYSTEM_SELF_RESTART_ENABLED=true
# SYSTEM_SELF_RESTART_COMMAND=./deploy/soc.sh restart api web
# SYSTEM_SELF_UPDATE_ENABLED=true
# SYSTEM_SELF_UPDATE_COMMAND=./deploy/release.sh
SYSTEM_CONTROL_REPO_ROOT=
SYSTEM_SELF_RESTART_ENABLED=false
SYSTEM_SELF_RESTART_COMMAND=
SYSTEM_SELF_UPDATE_ENABLED=false
SYSTEM_SELF_UPDATE_COMMAND=

# ── Threat Intel (P17) — Provider-Keys NUR hier (backend), nie ins Frontend/Git ──
# Leer lassen → Provider 'not_configured', Mock bleibt Fallback. Nur public IPs werden
# extern abgefragt (private/multicast/reserved nicht). Ergebnisse 24h gecacht.
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_AGE_DAYS=90
VIRUSTOTAL_API_KEY=

# Owned-Asset-Kontext fuer KI-Analysen.
# Wichtig fuer dataplane-/Honeypot-Tickets: eigene Decoys und interne Netze werden
# im AI Evidence Bundle markiert, damit externe Interaktion mit dem Decoy nicht als
# bestaetigte Cross-Domain-C2/Exfiltration geframed wird.
# Kommagetrennt, IPv4/CIDR. Leer = inert.
OWNED_HONEYPOT_IPS=203.0.113.10
OWNED_INTERNAL_CIDRS=10.99.99.0/24
# Nur setzen wenn QRadar/Splunk/ServiceNow tatsächlich genutzt wird:
# WEBHOOK_SECRET_QRADAR=CHANGE_ME
# WEBHOOK_SECRET_SPLUNK=CHANGE_ME
# WEBHOOK_SECRET_SERVICENOW=CHANGE_ME

# ── FQDN-Resolver (CE-5.3) — opt-in, read-only ────────────────
# Bestätigt für Network-Flows einen Kandidaten-Hostnamen gegen die Flow-IP
# (Forward-Confirm: Name → A-Record → enthält die IP?). KEINE Secrets.
# Default AUS: ohne FQDN_RESOLVER_ENABLED=true findet KEIN DNS-Lookup statt
# (missingReason 'disabled'). Nur read-only A-Record-Abfragen gegen den
# konfigurierten DNS-Server (z. B. AD-DNS).
FQDN_RESOLVER_ENABLED=false
# DNS-Server für die A-Record-Abfrage (leer = System-Resolver). AD-DNS empfohlen:
FQDN_DNS_SERVER=10.99.99.10
# Interne AD-Domäne (nur für Kontext/Anzeige):
FQDN_DOMAIN=nexora.example

# ── Rate Limiting ──────────────────────────────────────────────
# Pro Client-IP (App läuft mit trust proxy=1 hinter nginx → echte IP aus X-Forwarded-For).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# Separater, höherer Topf nur für eingehende Webhooks (SIEM-Bursts wie Wazuh),
# damit Alert-Wellen niemals UI/Login (RATE_LIMIT_MAX) blockieren:
RATE_LIMIT_WEBHOOK_MAX=1000

# ── KI-Agent / LLM (P19) ───────────────────────────────────────
# Provider: stub (Test) · ollama (lokal) · anthropic · openai · google.
# Default-Provider beim Boot; die UI (Settings → KI) kann live umschalten.
AGENT_LLM_PROVIDER=stub
# Nur relevant bei AGENT_LLM_PROVIDER=ollama.
# Externe Ollama-LXC (aktuell): http://10.99.99.78:11434
# Interner Compose-Service (Alternative): http://ollama:11434
OLLAMA_BASE_URL=http://10.99.99.78:11434
# CPU-only: llama3.2:3b empfohlen (~6–12s). llama3.1:8b ist CPU-gebunden zäh
# (~20–44s pro Antwort, unabhängig vom RAM) — nur mit GPU/starker CPU sinnvoll.
OLLAMA_MODEL=llama3.2:3b
# Timeout für Ollama-Calls (ms). 8B auf CPU + ausführliche Analyse braucht lange
# → 120s. Bei sehr langsamer Box höher, oder llama3.2:3b nutzen (schneller).
OLLAMA_TIMEOUT_MS=120000
# Maximale Antwortlänge. CPU-only hart begrenzen, sonst blockieren lange KI-Analysen
# den einzelnen Ollama-Slot minutenlang.
OLLAMA_NUM_PREDICT=512

# ── Cloud-LLM-Provider (opt-in) ─────────────────────────────────
# ⚠ DATENSCHUTZ: Bei Cloud-Providern verlassen Ticket-/Alert-Daten (ggf. PII/sensible
# Security-Daten) das interne Netz. Nur aktivieren, wenn rechtlich abgedeckt.
# API-Keys können ENTWEDER hier per ENV ODER bequem in der UI (Settings → KI) gesetzt
# werden — UI-Keys liegen AES-256-GCM-verschlüsselt in der DB (Schlüssel: SETTINGS_ENC_KEY
# oder Fallback JWT_SECRET). ENV hat Vorrang. Optional eigener Verschlüsselungs-Key:
# SETTINGS_ENC_KEY=  (>=32 Zeichen; sonst wird JWT_SECRET genutzt)
# Anthropic (Claude):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI (GPT):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Google AI (Gemini):
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-2.0-flash
# Gemeinsames Timeout für Cloud-Calls (ms):
# AGENT_CLOUD_TIMEOUT_MS=60000
