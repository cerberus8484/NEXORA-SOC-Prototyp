{
  "policy": {
    "policy_id": "suricata-flows-policy",
    "description": "Suricata-Flow-Telemetrie: Rollover 1d/5gb, Retention 14d (Lab-Start, konservativ).",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "rollover": {
              "min_index_age": "1d",
              "min_size": "5gb"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_index_age": "14d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [ { "delete": {} } ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": ["suricata-flows-*"],
        "priority": 100
      }
    ]
  }
}
