{
  "index_patterns": ["suricata-flows-*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "30s",
      "plugins.index_state_management.policy_id": "suricata-flows-policy",
      "plugins.index_state_management.rollover_alias": "suricata-flows"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp":   { "type": "date" },
        "timestamp":    { "type": "date", "format": "strict_date_optional_time||date_optional_time||epoch_millis" },
        "event_type":   { "type": "keyword" },
        "src_ip":       { "type": "ip" },
        "dest_ip":      { "type": "ip" },
        "src_port":     { "type": "long" },
        "dest_port":    { "type": "long" },
        "proto":        { "type": "keyword" },
        "app_proto":    { "type": "keyword" },
        "direction":    { "type": "keyword" },
        "flow_id":      { "type": "keyword" },
        "in_iface":     { "type": "keyword" },
        "community_id": { "type": "keyword" },
        "pipeline_source": { "type": "keyword" },
        "flow": {
          "properties": {
            "bytes_toserver": { "type": "long" },
            "bytes_toclient": { "type": "long" },
            "pkts_toserver":  { "type": "long" },
            "pkts_toclient":  { "type": "long" },
            "start":          { "type": "date", "format": "strict_date_optional_time||date_optional_time||epoch_millis" },
            "end":            { "type": "date", "format": "strict_date_optional_time||date_optional_time||epoch_millis" },
            "age":            { "type": "long" },
            "state":          { "type": "keyword" },
            "src_ip":         { "type": "ip" },
            "dest_ip":        { "type": "ip" }
          }
        }
      }
    }
  }
}
