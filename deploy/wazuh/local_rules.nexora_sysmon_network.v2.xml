<group name="nexora_sysmon_network,">

  <rule id="100951" level="3">
    <if_sid>92101</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell(?:_ise)?\.exe$|\\pwsh\.exe$</field>
    <description>Nexora: Sysmon Event 3 PowerShell NetworkConnect $(win.eventdata.image) -> $(win.eventdata.destinationIp):$(win.eventdata.destinationPort)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1071</id>
    </mitre>
    <group>nexora_sysmon_network,sysmon_event3,powershell_network,</group>
  </rule>

</group>
