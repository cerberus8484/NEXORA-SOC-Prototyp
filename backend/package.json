{
  "name": "soc-ticket-tool-backend",
  "version": "0.1.0",
  "description": "SOC Ticket Tool — Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:correlation-worker": "node src/correlationWorkerMain.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "admin:ensure": "node src/scripts/adminAccess.js --ensure",
    "admin:reset": "node src/scripts/adminAccess.js --reset",
    "smoke:deploy-linux-client": "node scripts/deployLinuxClientSmoke.js",
    "ml:eval-report": "node scripts/mlEvalReport.js",
    "ml:dataset-pack": "node scripts/mlEvalDatasetPack.js",
    "ml:dataset-split": "node scripts/mlEvalDatasetSplit.js",
    "ml:run-init": "node scripts/mlEvalRunInit.js",
    "ml:run-eval": "node scripts/mlEvalRunEvaluate.js",
    "ml:readiness": "node scripts/mlEvalReadiness.js",
    "ml:gold-merge": "node scripts/mlGoldMerge.js",
    "ml:gold-pipeline": "node scripts/mlEvalGoldPipeline.js",
    "ml:run-compare": "node scripts/mlEvalRunCompare.js",
    "ml:run-policy-compare": "node scripts/mlEvalRunPolicyCompare.js",
    "ml:policy-export": "node scripts/mlEvalPolicyExport.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:queue:integration": "node --test test-integration/pgBossQueue.integration.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "imapflow": "^1.4.0",
    "joi": "^18.2.1",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "pg-boss": "^12.18.2",
    "prom-client": "^15.1.3",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
