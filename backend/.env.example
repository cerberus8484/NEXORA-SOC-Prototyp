# SOC Ticket Tool — Backend Environment
# Kopiere nach .env und passe an

NODE_ENV=development
PORT=3000

# CORS — kommagetrennte Origins
CORS_ORIGINS=http://localhost:5500,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Logging
LOG_LEVEL=info

# P5 — PostgreSQL
# Lokal mit Docker (Repo-Root): docker compose -f docker-compose.dev.yml up -d
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soc_tickets_dev
DB_USER=soc_api
DB_PASSWORD=devpassword
DB_POOL_MAX=10
DB_SSL=false

# Test-DB (separater Port)
# DB_TEST_HOST=localhost
# DB_TEST_PORT=5433
# DB_TEST_NAME=soc_tickets_test

# P6 — Auth
# WICHTIG: Starkes Secret in Produktion (min. 32 Zeichen, zufällig)
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=8h

# Audit-Log IP-Pseudonymisierung (DSGVO Art. 25) — in Produktion ZWINGEND setzen,
# sonst ist die IP-HMAC mit dem bekannten Dev-Default de-anonymisierbar.
# Min. 32 zufällige Zeichen. validateEnv warnt in Produktion, wenn ungesetzt/Default.
AUDIT_IP_SALT=dev-audit-ip-salt-change-in-production

# Optionale ML-Routing-Policy (ml:policy-export → recommended-routing-policy.json).
# Wenn gesetzt UND status=ready: KI-Vorschläge erhalten ein advisory routing-Feld
# (auto_accept_eligible / route_to_review) anhand der belegten Threshold-Policy.
# Kein Auto-Handeln — nur ein Triage-Hinweis. Ungesetzt/blocked/fehlerhaft = AUS
# (fail-safe, kein Verhaltenswechsel).
# ML_ROUTING_POLICY_PATH=/opt/nexora/ml/recommended-routing-policy.json

# Optionaler Scrape-Token für GET /metrics (Defense-in-Depth ZUSÄTZLICH zum IP-Gate).
# Wenn gesetzt, muss Prometheus/Grafana `Authorization: Bearer <token>` mitsenden.
# Ungesetzt = nur IP-Gate (kein Verhaltenswechsel).
# METRICS_TOKEN=

# P7 — Webhook Secrets (pro Quelle, min. 32 Zeichen)
WEBHOOK_SECRET_GENERIC=dev-webhook-secret-change-in-production
# WEBHOOK_SECRET_QRADAR=...
# WEBHOOK_SECRET_SPLUNK=...
# SPLUNK_BASE_URL=https://splunk.example.com:8089
# WEBHOOK_SECRET_SPLUNK=...
# WEBHOOK_SECRET_WAZUH=<32-Zeichen-Secret — siehe integrations/wazuh/setup-instructions.md>
# WEBHOOK_SECRET_SERVICENOW=...

# ── E-Mail: Outbound-Notifications + Phishing-Ingest (ADR-037) ───────────────
# Self-hosted Mailserver siehe deploy/mailserver/ (Stalwart + Smarthost-Relay).
# Outbound zusätzlich durch NOTIFICATIONS_OUTBOUND_ENABLED gegated (Default aus).
# NOTIFICATIONS_OUTBOUND_ENABLED=true
# NOTIFY_SMTP_HOST=mail.nexora.local
# NOTIFY_SMTP_PORT=587              # 587 = STARTTLS · 465 = implizit TLS
# NOTIFY_SMTP_SECURE=false         # true für Port 465
# NOTIFY_SMTP_USER=notify@nexora.local
# NOTIFY_SMTP_PASS=<konto-passwort>
# NOTIFY_EMAIL_FROM=notify@nexora.local
# NOTIFY_EMAIL_TO=soc-team@example.com   # kommagetrennte Empfängerliste
# Phishing-Postfach (IMAP-Poller bleibt inert ohne HOST/USER/PASSWORD):
# IMAP_HOST=mail.nexora.local
# IMAP_PORT=993
# IMAP_TLS=true                    # 'false' für STARTTLS/Klartext-Port
# IMAP_USER=phishing@nexora.local
# IMAP_PASSWORD=<konto-passwort>

# ── Owned-Asset-Kontext für die KI-Analyse ───────────────────────────────────
# Ohne dieses Wissen liest die KI Kommunikation zum eigenen Honeypot als
# "unbekannte IP". Die IPs/CIDRs werden im AI Evidence Bundle pro Ticket getaggt
# (eigener Honeypot / internes Asset / extern). Beides kommagetrennt, IPv4.
# OWNED_HONEYPOT_IPS=31.70.103.246,10.0.10.80
# OWNED_INTERNAL_CIDRS=10.0.10.0/24,192.168.0.0/16

# ── QRadar-Verbindung (jetzt auch UI-verwaltbar; ENV bleibt Fallback) ─────────
# Werte aus der DB (Administration → Services) haben Vorrang, ENV ist Rückfall.
# QRADAR_BASE_URL=https://qradar.example.com
# QRADAR_TOKEN=<qradar-sec-token>
# Gesetzt = QRadar-Processor wird beim Boot registriert (Offense→Ticket); leer = QRadar inaktiv.
# QRADAR_HOST=qradar.example.com
# 'true' erzwingt gültiges TLS-Zertifikat der QRadar-API; alles andere (Default) akzeptiert Self-Signed.
# QRADAR_TLS_REJECT_UNAUTHORIZED=false

# ── Feature-Gates (alle default AUS/false, fail-safe) ─────────────────────────
# Hunt-Response Auto-Execute (Mock) — nur Übungs-/Testmodus, kein echtes Handeln.
# HUNT_RESPONSE_AUTO_EXECUTE_MOCK=false
# Config-Apply-Kanal scharfschalten (schreibt Konfiguration) — default false.
# CONFIG_APPLY_ENABLED=false
# Wazuh-FP-Workflow scharfschalten (spielt FP-Regel aus) — default false.
# WAZUH_FP_APPLY_ENABLED=false
