# Shell-Skripte und systemd-Units müssen plattformunabhängig mit LF auschecken —
# CRLF würde auf Linux "/bin/sh^M: bad interpreter" bzw. kaputte Units erzeugen.
*.sh        text eol=lf
*.service   text eol=lf
# Env-Vorlagen + Configs, die zur Laufzeit gelesen/kopiert werden, ebenfalls LF —
# ein CRLF-Wert (z. B. TLS_CERT_PATH) bricht sonst den Container-Bind-Mount/nginx.
*.example   text eol=lf
.env*       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
