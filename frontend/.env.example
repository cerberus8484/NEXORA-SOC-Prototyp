# API-Basis (Default: /api/v1 via Vite-Proxy auf VITE_API_TARGET)
VITE_API_BASE=/api/v1
# Backend-Ziel für den Dev-Proxy
VITE_API_TARGET=http://localhost:3000

# Internes Wiki (mkdocs-Doku) für die „Mehr erfahren"-Links in den Erklär-Tooltips.
# Ohne diesen Wert erscheint KEIN „more"-Link (statt eines toten Links) — die Tooltips
# zeigen dann nur den Kurz-Hinweis. Root-relativ (z.B. /docs, wenn nginx die gebaute
# mkdocs-Site unter /docs ausliefert — air-gapped-tauglich) oder absolute https-URL.
# Bauen der Site:  pip install -r requirements-docs.txt && python -m mkdocs build
# VITE_WIKI_BASE_URL=/docs
